{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "lint": "oxlint --import-plugin --react-plugin --jsx-a11y-plugin --deny-warnings src vite.config.ts tests/*.mjs",
    "build": "tsc --noEmit && vite build",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test -c tests/playwright.config.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource/instrument-serif": "5.2.8",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "oxlint": "1.95.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
